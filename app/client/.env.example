# Copy this file to .env.local (same folder). Only public values go here,
# because everything in this file ends up in the files of the web page.

# From the Supabase project: Project Settings, API Keys.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLIC_KEY=

# The address of our server.
VITE_SERVER_URL=http://127.0.0.1:8787

# Optional. The public half of the notification keys of the server.
# VITE_VAPID_PUBLIC_KEY=
