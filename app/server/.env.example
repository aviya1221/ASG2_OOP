# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: never commit a real key.

# ---------------------------------------------------------------- Web server
# Needed to run the server, not to run the unit tests or the Gemini smoke script.

# Port to listen on (default 8787). Render sets this by itself.
# PORT=8787

# The address of the web client. Several addresses are separated by commas.
WEB_ORIGIN=http://localhost:5173

# From the Supabase project: Project Settings, API Keys. The secret key stays on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Keys for phone notifications. Without them the server runs and sends none.
# Create a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-site.example

# ---------------------------------------------------------------- LLM
# Which LLM client the server uses: "gemini" (real calls) or "fake"
# (canned answers, no key needed: tests, offline demo, plan B).
LLM_PROVIDER=gemini

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model used for text and JSON answers (default: gemini-3.6-flash,
# the current stable Flash model). See https://aistudio.google.com/docs/models
# GEMINI_TEXT_MODEL=gemini-3.6-flash

# Optional. Model that reviews homework solutions (default: gemini-3.5-flash-lite,
# chosen in ADR-9 of docs/02-tools-report.md). The review guides use GEMINI_TEXT_MODEL.
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite

# Optional. Model used to compare texts (default: gemini-embedding-2).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
