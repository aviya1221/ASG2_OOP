{
  "name": "asg2-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server side of the web-based teaching tool (Ex2).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "pretest": "node -e \"fs.mkdirSync('../reports',{recursive:true})\"",
    "pretest:integration": "node -e \"fs.mkdirSync('../reports',{recursive:true})\"",
    "test": "tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../reports/server-unit.xml \"test/**/*.test.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../reports/integration.xml \"test-integration/**/*.test.ts\"",
    "smoke:gemini": "tsx --env-file-if-exists=.env scripts/gemini-smoke.ts",
    "real:homework": "tsx --env-file-if-exists=.env scripts/homework-real-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "2.119.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "multer": "2.0.2",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
